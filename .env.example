# Copy this file to .env and fill in your values. .env is gitignored — never commit it.

# Mesh API (MANDATORY — every LLM call must route through this)
MESH_API_KEY=rsk_your_api_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-4.1-nano
# Real embeddings for the vector store (app/vector.py) once MESH_API_KEY is set — falls
# back to a deterministic offline embedding if unset. Cheapest embedding-capable model
# on Mesh as of this writing.
MESH_EMBEDDING_MODEL=google/embeddinggemma-300m

# Database
DATABASE_URL=sqlite:///trailmind.db

# FastAPI
SECRET_KEY=change-me-to-a-random-secret
DEBUG=true
# Set true only behind HTTPS (e.g. the Render deploy — see render.yaml) so the session
# cookie is never sent over plain HTTP. Leave false for local http://localhost.
SESSION_COOKIE_SECURE=false

# Chroma vector DB
CHROMA_DB_PATH=./chroma_data
CHROMA_COLLECTION_NAME=models
# Dimensionality of the deterministic hashed bag-of-words embedding fallback (used only
# when MESH_API_KEY is unset) — changing this invalidates any already-indexed vectors.
EMBEDDING_DIMENSION=64

# LangSmith (optional, bonus observability)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trailmind

# Scheduled digest (optional, bonus — DLV-3). Neither channel configured falls back to
# logging the digest instead of dropping it. Cron defaults to 09:00 local server time daily.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_CRON_HOUR=9
DIGEST_CRON_MINUTE=0
# Public URL of the deployed app, if any — powers the "View full dashboard" link in the
# HTML digest email. Leave unset locally; the link is simply omitted, not broken.
APP_BASE_URL=

# Hackathon submission
SUBMISSION_TOKEN=
